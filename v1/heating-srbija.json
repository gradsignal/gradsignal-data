о ефикаснијег решавања пријављеног проблема. Ова два броја мобилних телефона служе искључиво за пријаву рекламација путем СМС поруке и апелујемо на кориснике услуга да поменуте бројеве не користе у друге сврхе. У случају цурења н"}],"geo":{"source":"OpenStreetMap","attribution":"© OpenStreetMap contributors, ODbL","locations":40,"found":37,"by_kind":{"place~":20,"addresses":8,"none":3,"street~":5,"street":4}},"coverage":{"Beograd":["Novi Beograd","Palilula","Rakovica","Savski venac","Stari grad","Voždovac","Vračar","Zemun","Zvezdara","Čukarica"],"Novi Sad":["Novi Sad"]},"coverage_partial":{"Beograd":["Barajevo","Mladenovac"],"Obrenovac":["Obrenovac"]},"coverage_partial_reason":{"Obrenovac":"incomplete"}}
