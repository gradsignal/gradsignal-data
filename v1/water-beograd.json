нотравске улице до Насеља Јајинци, као и у Селу Раковица. У току радова може доћи и до краткотрајног замућења воде. Молимо потрошаче да претходно припреме неопходну залиху воде за пиће и основне потребе. Екипе Београдског водовода ће се трудити да радове обаве у што краћем року. Захваљујемо грађанима на стрпљењу и разумевању. Планирани радови на испирању водоводне мреже обезбедиће да вода на чесмама потрошача и даље буде проверено доброг квалитета."},"warnings":["područje je zadato blokovima ili naseljem, bez ulica; na mapi je približno"],"region":"Beograd","units":["Voždovac"]},{"key":"e4d58b27ca4ac340","source_id":"jpkp-lazarevac","source_url":"https://jpkp.rs/","utility_type":"water","notice_type":"planned_work","status":"planned","verification":"official","date":"2026-11-06","municipality":"Лазаревац","municipality_lat":"Lazarevac","time_text":"","planned_start_at":null,"planned_end_at":null,"estimated_restoration_at":null,"title":"Планиране интервенције на водоводној мрежи","locations":[{"settlement":null,"settlement_lat":null,"street":"Колубарски трг","street_lat":"Kolubarski trg","numbers":[],"detail":"занатски центар","geo":{"kind":"street","lines":[[[44.37943,20.26398],[44.37869,20.26456]],[[44.37782,20.26547],[44.37658,20.26681],[44.37493,20.26867],[44.37423,20.27052],[44.37175,20.27533],[44.36775,20.2786],[44.36652,20.28008],[44.3651,20.28105],[44.36384,20.28159],[44.36362,20.2818],[44.36202,20.28424],[44.36113,20.28654],[44.35993,20.28883],[44.35847,20.291],[44.35751,20.29199],[44.3572,20.2925],[44.35637,20.29333],[44.35577,20.29359],[44.35531,20.29449],[44.35474,20.29483],[44.35399,20.29482],[44.3533,20.29454],[44.35173,20.29423],[44.35086,20.29387],[44.34994,20.29401],[44.34975,20.29388],[44.34957,20.29339],[44.34898,20.294],[44.34849,20.29392],[44.34771,20.29471],[44.34716,20.29547],[44.34728,20.29583],[44.34803,20.2961],[44.34812,20.2964],[44.34808,20.29711],[44.34825,20.29767],[44.34826,20.29848],[44.34807,20.29904],[44.34721,20.29956],[44.34707,20.