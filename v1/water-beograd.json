ошаче да претходно припреме неопходну залиху воде за пиће и основне потребе. Екипе Београдског водовода ће се трудити да радове обаве у што краћем року. Захваљујемо грађанима на стрпљењу и разумевању. Планирани радови на испирању водоводне мреже обезбедиће да вода на чесмама потрошача и даље буде проверено доброг квалитета."},"warnings":["područje je zadato blokovima ili naseljem, bez ulica; na mapi je približno"],"region":"Beograd","units":["Vračar"]},{"key":"69bd049c945ba889","source_id":"vikgrocka","source_url":"https://vodovodgrocka.org.rs/2026/11/20/obavestenje-za-naselje-umcari-20-11-2026/","utility_type":"water","notice_type":"fault","status":"active","verification":"official","date":"2026-11-20","municipality":"Гроцка","municipality_lat":"Grocka","time_text":"","planned_start_at":null,"planned_end_at":null,"estimated_restoration_at":null,"title":"Обавештење за насеље Умчари","locations":[{"settlement":"Умчари","settlement_lat":"Umčari","street":null,"street_lat":null,"numbers":[],"partial":true,"possible":false,"geo":{"kind":"place","points":[[44.58347,20.73491]],"approx":true,"place":"Umčari","place_type":"village","outline":[[[44.56927,20.70405],[44.56891,20.70439],[44.56843,20.70424],[44.5676,20.70456],[44.5664,20.70581],[44.56538,20.70607],[44.56454,20.70728],[44.56421,20.70847],[44.5623,20.71056],[44.56232,20.71083],[44.56026,20.71163],[44.56021,20.71207],[44.55841,20.71195],[44.55691,20.71105],[44.55618,20.71117],[44.55553,20.71171],[44.5544,20.71204],[44.55374,20.7113],[44.55308,20.71095],[44.55192,20.71091],[44.55014,20.71131],[44.54836,20.71208],[44.54565,20.71424],[44.54186,20.71563],[44.5409,20.71677],[44.54252,20.71663],[44.54292,20.71768],[44.54446,20.71823],[44.54546,20.71929],[44.54575,20.72009],[44.54654,20.72066],[44.54742,20.72253],[44.54785,20.72269],[44.5487,20.72252],[44.54942,20.72459],[44.55017,20.72523],[44.55133,20.72518],[44.5528,20.72459],[44.55301,20.72536],[44.55343,20.72535],[44.55327,20.72395],[44.55359,20.72375],[44.55473,20.7