ног замућења воде. Молимо потрошаче да претходно припреме неопходну залиху воде за пиће и основне потребе. Екипе Београдског водовода ће се трудити да радове обаве у што краћем року. Захваљујемо грађанима на стрпљењу и разумевању. Планирани радови на испирању водоводне мреже обезбедиће да вода на чесмама потрошача и даље буде проверено доброг квалитета."},"warnings":["područje je zadato blokovima ili naseljem, bez ulica; na mapi je približno"],"region":"Beograd","units":["Vračar"]},{"key":"759b15e25de05626","source_id":"jpkp-lazarevac","source_url":"https://jpkp.rs/","utility_type":"water","notice_type":"planned_work","status":"planned","verification":"official","date":"2026-11-18","municipality":"Лазаревац","municipality_lat":"Lazarevac","time_text":"","planned_start_at":null,"planned_end_at":null,"estimated_restoration_at":null,"title":"Планиране интервенције на водоводној мрежи","locations":[{"settlement":null,"settlement_lat":null,"street":"Бошка Бухе","street_lat":"Boška Buhe","numbers":[{"raw":"2","from_raw":"2","to_raw":"2","from":2,"to":2,"without_number":false}],"geo":{"kind":"addresses","street":"Boška Buhe","lines":[[[44.38689,20.26571],[44.38672,20.26561]]],"points":[[44.38689,20.26583]],"possible":[[44.38672,20.26576]],"unit":"Lazarevac"}},{"settlement":null,"settlement_lat":null,"street":"Јелене Ћетковић","street_lat":"Jelene Ćetković","numbers":[{"raw":"8","from_raw":"8","to_raw":"8","from":8,"to":8,"without_number":false}],"geo":{"kind":"addresses","street":"Jelene Ćetković","lines":[[[44.37203,20.27212],[44.37177,20.27177]]],"points":[[44.37194,20.27188]],"unit":"Lazarevac"}},{"settlement":null,"settlement_lat":null,"street":"Шумадијска","street_lat":"Šumadijska","numbers":[{"raw":"38а","from_raw":"38а","to_raw":"38а","from":38,"to":38,"without_number":false}],"geo":{"kind":"addresses","street":"Šumadijska","lines":[[[44.37433,20.27369],[44.37432,20.27319]]],"points":[[44.374,20.27345]],"possible":[[44.37372,20.27351]],"unit":"Lazarevac"}},{"settlem